[Unit]
Description=Demo FYC API
After=network.target

[Service]
Type=simple
User=demo-fyc
WorkingDirectory=/opt/demo-fyc-api/build
EnvironmentFile=/etc/demo-fyc-api/demo-fyc-api.env
ExecStart=/usr/bin/node bin/server.js
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
